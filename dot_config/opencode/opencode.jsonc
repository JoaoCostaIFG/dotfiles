{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@v0.0.6",
  ],
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
      }
    },
    "plan": {
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.6",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "mcp": {
    "n8n": {
      "type": "remote",
      "url": "https://n8n.joaocosta.dev/mcp-server/http",
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "firefox"
      ],
      "enabled": false
    },
    "markitdown": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "markitdown-mcp"
      ],
      "enabled": false,
    },
    "oci-cloud": {
      "type": "local",
      "command": [
        "uvx",
        "oracle.oci-cloud-mcp-server@latest"
      ],
      "enabled": false,
      "environment": {
        "OCI_CONFIG_PROFILE": "DEFAULT",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
    },
  }
}
