{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "update": "disable",
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "markitdown": {
        "type": "local",
        "command": [
          "uv",
          "tool",
          "run",
          "markitdown-mcp"
        ],
      },
      "zai-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@z_ai/mcp-server"
        ],
        "environment": {
          "Z_AI_MODE": "ZAI"
        }
      },
      "n8n": {
        "type": "remote",
        "url": "https://n8n.joaocosta.dev/mcp-server/http",
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--browser",
          "firefox"
        ],
        "disabled": true,
      },
      "oci-cloud": {
        "type": "local",
        "command": [
          "uvx",
          "oracle.oci-cloud-mcp-server@latest"
        ],
        "environment": {
          "OCI_CONFIG_PROFILE": "DEFAULT",
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "disabled": true,
      }
    }
  }
}
