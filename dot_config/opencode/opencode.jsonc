{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  },
  "mcp": {
    "n8n": {
      "type": "remote",
      "url": "https://n8n.joaocosta.dev/mcp-server/http",
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "firefox"
      ],
      "enabled": false
    },
    "markitdown": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "markitdown-mcp"
      ],
      "enabled": false,
    },
    "oci-cloud": {
      "type": "local",
      "command": [
        "uvx",
        "oracle.oci-cloud-mcp-server@latest"
      ],
      "enabled": false,
      "environment": {
        "OCI_CONFIG_PROFILE": "DEFAULT",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "enabled": false,
      "environment": {
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
